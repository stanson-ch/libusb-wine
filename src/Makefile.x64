all:

PROJ = libusb0

CFLAGS = -g -O2 \
  -fPIC \
  -Wall \
  -pipe \
  -fno-strict-aliasing \
  -Wempty-body \
  -Wignored-qualifiers \
  -Wstrict-prototypes \
  -Wtype-limits \
  -Wunused-but-set-parameter \
  -Wvla \
  -Wwrite-strings \
  -Wpointer-arith \
  -Wlogical-op \
  -Wno-format-truncation \
  -gdwarf-2 \
  -gstrict-dwarf \
  -fno-omit-frame-pointer \
  -Werror=missing-prototypes \
  -Werror=implicit-function-declaration

LDFLAGS = -lpthread

OBJS = linux.o error.o usb.o descriptors.o usb-wine.o

WINE_INCLUDE = /usr/include/wine/wine/windows

CC = gcc
WINEGCC = winegcc
WINEBUILD = winebuild

dlldir = /usr/lib/x86_64-linux-gnu/wine

$(OBJS):%.o: %.c
	$(CC) -c -o $@ $^ -I. -I$(WINE_INCLUDE) -D__WINESRC__ -D_REENTRANT $(CFLAGS)

$(PROJ).dll.so $(PROJ).dll.fake: $(PROJ).spec $(OBJS)
	$(WINEGCC) -o $@ -B$(WINEBUILD) -fasynchronous-unwind-tables -shared $(PROJ).spec \
  $(OBJS) $(LDFLAGS)

$(PROJ).a: $(PROJ).spec
	$(WINEBUILD) -w --implib -o $@ --export $(PROJ).spec

$(PROJ).def: $(PROJ).spec
	$(WINEBUILD) -w --def -o $@ --export $(PROJ).spec

$(PROJ).cross.a: $(PROJ).spec
	$(WINEBUILD) -w --implib -o $@ --export $(PROJ).spec

all: $(PROJ).dll.so $(PROJ).dll.fake

# Wine 6.8 and later keep builtin DLLs in a folder per architecture: the
# library in x86_64-unix, its placeholder in x86_64-windows. Wine copies
# the placeholder into a prefix's system32 when it creates or updates the
# prefix, and programs find the library only through that placeholder.
install install-lib:: $(PROJ).dll.so $(PROJ).dll.fake
	mkdir -p $(DESTDIR)$(dlldir)/x86_64-unix $(DESTDIR)$(dlldir)/x86_64-windows
	cp $(PROJ).dll.so $(DESTDIR)$(dlldir)/x86_64-unix/$(PROJ).dll.so
	cp $(PROJ).dll.fake $(DESTDIR)$(dlldir)/x86_64-windows/$(PROJ).dll

# the import library winegcc links winelib programs such as lsusb-wine with
install install-dev:: $(PROJ).a
	mkdir -p $(DESTDIR)$(dlldir)/x86_64-unix
	cp $(PROJ).a $(DESTDIR)$(dlldir)/x86_64-unix/$(PROJ).a

uninstall::
	rm -f $(DESTDIR)$(dlldir)/x86_64-unix/$(PROJ).dll.so \
  $(DESTDIR)$(dlldir)/x86_64-windows/$(PROJ).dll \
  $(DESTDIR)$(dlldir)/x86_64-unix/$(PROJ).a

clean::
	rm -f *.def *.a *.o *.so *.fake

.PHONY: all install install-lib install-dev uninstall clean
